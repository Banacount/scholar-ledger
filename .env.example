# Aiven MySQL Service URI (leave empty locally to use built-in SQLite)
SERVICE_URI="mysql://avnadmin:YOUR_PASSWORD@your-mysql-host.aivencloud.com:PORT/defaultdb?ssl-mode=REQUIRED"

# Secret for signing auth tokens in production (set a random 32+ char string on Vercel)
SESSION_SECRET="replace-with-a-random-secret-key"

# Runtime / AI Studio environment variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
