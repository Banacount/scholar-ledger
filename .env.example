# Aiven MySQL Service URI targeting the "sms" database (leave empty locally to use built-in SQLite)
SERVICE_URI="mysql://avnadmin:YOUR_PASSWORD@your-mysql-host.aivencloud.com:PORT/sms?ssl-mode=REQUIRED"

# Secret for signing auth tokens in production (set a random 32+ char string on Vercel)
SESSION_SECRET="replace-with-a-random-secret-key"
